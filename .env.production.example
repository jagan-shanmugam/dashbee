# ===================================
# DashBee Production Configuration
# ===================================

# Copy this file to .env.production and fill in your values
# For Docker Compose deployment: cp .env.production.example .env.production

# ===================================
# Required: Node Environment
# ===================================
NODE_ENV=production

# ===================================
# Required: Database Configuration
# ===================================

# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://dashbee:YOUR_DB_PASSWORD@postgres:5432/dashbee

# For external PostgreSQL (not using docker-compose postgres service):
# DATABASE_URL=postgresql://user:password@your-db-host:5432/dashbee
# DATABASE_SSL=true

# For MySQL:
# DATABASE_URL=mysql://user:password@mysql-host:3306/dashbee

# For SQLite (single-instance only):
# SQLITE_PATH=./data/dashbee.db

# ===================================
# Required: AI Provider
# ===================================

# Option 1: OpenAI
OPENAI_API_KEY=sk-...

# Option 2: Azure OpenAI
# OPENAI_BASE_URL=https://your-resource.openai.azure.com
# OPENAI_API_KEY=...

# Option 3: OpenRouter (alternative to OpenAI)
# OPENROUTER_API_KEY=sk-or-...

# Option 4: Google Gemini
# GEMINI_API_KEY=...

# ===================================
# Required: Security
# ===================================

# Session encryption secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE

# Database password (used by docker-compose.production.yml)
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# ===================================
# Optional: Database Settings
# ===================================

# SSL for database connections (set to true if using external DB with SSL)
DATABASE_SSL=false

# Allowed database schemas (comma-separated)
ALLOWED_SCHEMAS=public

# Query limits
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_MS=5000

# ===================================
# Optional: LLM Observability (Langfuse)
# ===================================

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===================================
# Optional: Cloud Storage (AWS S3)
# ===================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ===================================
# Optional: Cloud Storage (Google Cloud)
# ===================================

GCS_PROJECT_ID=
GCS_KEY_FILE=

# ===================================
# Optional: Application Settings
# ===================================

# Port (only needed if not using Docker)
# PORT=3000

# Public URL (for webhooks, OAuth callbacks, etc.)
# NEXT_PUBLIC_APP_URL=https://dashbee.example.com

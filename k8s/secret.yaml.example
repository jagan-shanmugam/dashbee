apiVersion: v1
kind: Secret
metadata:
  name: dashbee-secrets
  namespace: dashbee
  labels:
    app: dashbee
type: Opaque
stringData:
  # Database URL (plain text - will be base64 encoded by kubectl)
  database-url: "postgresql://user:password@postgres-service:5432/dashbee"

  # Or use external database:
  # database-url: "postgresql://user:password@your-rds-endpoint.amazonaws.com:5432/dashbee"

  # OpenAI API key
  openai-api-key: "sk-..."

  # Or Azure OpenAI:
  # openai-base-url: "https://your-resource.openai.azure.com"
  # openai-api-key: "..."

  # Or OpenRouter:
  # openrouter-api-key: "sk-or-..."

  # NextAuth secret (generate with: openssl rand -base64 32)
  nextauth-secret: "REPLACE_WITH_GENERATED_SECRET"

  # Optional: Langfuse
  # langfuse-secret-key: "sk-lf-..."
  # langfuse-public-key: "pk-lf-..."

  # Optional: AWS S3
  # aws-access-key-id: "AKIA..."
  # aws-secret-access-key: "..."

  # Optional: Google Cloud Storage
  # gcs-project-id: "my-project"
  # gcs-key-file: "BASE64_ENCODED_SERVICE_ACCOUNT_JSON"

---
# How to create this secret from command line:
#
# kubectl create secret generic dashbee-secrets \
#   --from-literal=database-url='postgresql://user:password@postgres:5432/dashbee' \
#   --from-literal=openai-api-key='sk-...' \
#   --from-literal=nextauth-secret="$(openssl rand -base64 32)" \
#   --namespace=dashbee
#
# Or for already base64-encoded values, use:
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: dashbee-secrets
#   namespace: dashbee
# type: Opaque
# data:
#   database-url: cG9zdGdyZXNxbDovL3VzZXI6cGFzc3dvcmRAcG9zdGdyZXM6NTQzMi9kYXNoYmVl
#   openai-api-key: c2stLi4u
#   nextauth-secret: eW91ci1iYXNlNjQtZW5jb2RlZC1zZWNyZXQ=
